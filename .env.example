# Copy to .env and fill in. .env is git-ignored: never commit it.
# Load it into your shell before running any command (README §3).

# AWS CLI profile for the target account. Used by every `uv run` command,
# the UI, the aws CLI, and cdk. A --profile flag on a command overrides it.
AWS_PROFILE=your-aws-profile

# Region for the aws CLI. The template deploys to `region` in
# config/deploy.yaml, so keep the two the same.
AWS_REGION=eu-central-1

# Optional: billing reconciliation (gate G11) window in whole days. Default 3.
# TMPL_G11_DAYS=3
